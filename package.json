{
  "name": "@fetchkit/chaos-sw",
  "version": "0.1.0",
  "description": "Configurable chaos middleware for browser requests through a Service Worker",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "chaos-sw": "./bin/chaos-sw.mjs"
  },
  "files": [
    "bin",
    "dist",
    "public/chaos-sw.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./chaos-sw.js": "./public/chaos-sw.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "npm run test:ci",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:ci": "npm run test:unit && npm run test:e2e",
    "test:browser": "npm run build && playwright test test/service-worker.spec.ts test/package-build.spec.ts test/init.spec.ts",
    "test:node": "playwright test test/node-compat.spec.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "prepublishOnly": "npm run typecheck && npm run test:ci",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "@fetchkit/chaos-fetch": "^1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fetch-kit/chaos-sw.git"
  },
  "homepage": "https://github.com/fetch-kit/chaos-sw#readme",
  "bugs": "https://github.com/fetch-kit/chaos-sw/issues",
  "author": "Gabor Koos <gabor@gaborkoos.com>",
  "license": "MIT",
  "keywords": [
    "chaos",
    "service-worker",
    "fetch",
    "testing",
    "typescript"
  ]
}
