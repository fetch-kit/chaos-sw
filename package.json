{
  "name": "@fetchkit/chaos-sw",
  "version": "0.1.0",
  "description": "Configurable chaos middleware for browser requests through a Service Worker",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "chaos-sw": "./bin/chaos-sw.mjs"
  },
  "files": ["bin", "dist", "public/chaos-sw.js", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./chaos-sw.js": "./public/chaos-sw.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "npm run test:ci",
    "test:ci": "npm run build && playwright test",
    "test:browser": "npm run build && playwright test test/service-worker.spec.ts test/package-build.spec.ts test/init.spec.ts",
    "test:node": "playwright test test/node-compat.spec.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "prepublishOnly": "npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@fetchkit/chaos-fetch": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
