{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "@playwright/test"]
  },
  "include": ["src/index.ts", "src/protocol.ts", "test", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tsup.config.ts"],
  "exclude": ["test/unit/worker.test.ts"]
}
